<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Área de Saque | OlympusPay</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
    
    <style>
        :root {
            --bg-dark: #0f172a;
            --card-bg: #1e293b;
            --input-bg: #0f172a;
            --border-color: #334155;
            --primary-gradient: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
            --text-primary: #f8fafc;
            --text-secondary: #cbd5e1;
        }

        body {
            background-color: var(--bg-dark);
            font-family: 'Inter', sans-serif;
            color: var(--text-primary);
        }

        /* --- NAVBAR --- */
        .navbar {
            background: rgba(15, 23, 42, 0.95);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(255,255,255,0.05);
            padding: 1rem 0;
        }

        .btn-back {
            color: var(--text-secondary);
            text-decoration: none;
            font-weight: 600;
            display: flex; align-items: center; gap: 8px;
            transition: 0.3s;
        }
        .btn-back:hover { color: white; transform: translateX(-5px); }

        /* --- CARDS & FORMULÁRIO --- */
        .glass-panel {
            background: var(--card-bg);
            border: 1px solid rgba(255,255,255,0.05);
            border-radius: 24px;
            padding: 30px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
        }

        .balance-card {
            background: var(--primary-gradient);
            border-radius: 16px;
            padding: 20px;
            color: white;
            margin-bottom: 25px;
            position: relative;
            overflow: hidden;
        }
        .balance-card::after {
            content: ''; position: absolute; top: -50%; right: -20%;
            width: 150px; height: 150px; background: rgba(255,255,255,0.1);
            border-radius: 50%; pointer-events: none;
        }

        .form-label {
            color: var(--text-secondary);
            font-size: 0.9rem;
            margin-bottom: 8px;
        }

        .form-control, .form-select {
            background-color: var(--input-bg);
            border: 1px solid var(--border-color);
            color: white;
            padding: 14px;
            border-radius: 12px;
            font-size: 1rem;
        }
        
        .form-control:focus, .form-select:focus {
            background-color: var(--input-bg);
            border-color: #6366f1;
            color: white;
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.2);
        }
        .form-control::placeholder { color: #64748b; }

        .btn-action {
            background: var(--primary-gradient);
            border: none;
            padding: 16px;
            border-radius: 12px;
            font-weight: 700;
            color: white;
            width: 100%;
            font-size: 1.1rem;
            transition: 0.3s;
            box-shadow: 0 4px 15px rgba(99, 102, 241, 0.4);
        }
        .btn-action:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(99, 102, 241, 0.5);
            color: white;
        }

        /* --- HISTÓRICO EM LISTA (TIPO NUBANK) --- */
        .history-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 16px 0;
            border-bottom: 1px solid rgba(255,255,255,0.05);
            transition: 0.2s;
        }
        .history-item:hover { background: rgba(255,255,255,0.02); padding-left: 10px; padding-right: 10px; border-radius: 10px; }
        .history-item:last-child { border-bottom: none; }

        .icon-box {
            width: 45px; height: 45px;
            border-radius: 12px;
            background: rgba(239, 68, 68, 0.1);
            color: #ef4444;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.2rem;
            margin-right: 15px;
        }

        .status-badge {
            font-size: 0.75rem;
            padding: 4px 10px;
            border-radius: 20px;
            font-weight: 600;
        }
        .status-success { background: rgba(34, 197, 94, 0.1); color: #4ade80; }
        .status-pending { background: rgba(234, 179, 8, 0.1); color: #facc15; }
        .status-failed { background: rgba(239, 68, 68, 0.1); color: #f87171; }

        .btn-sync {
            background: transparent;
            border: 1px solid rgba(255,255,255,0.1);
            color: var(--text-secondary);
            width: 30px; height: 30px;
            border-radius: 50%;
            display: inline-flex; align-items: center; justify-content: center;
            transition: 0.3s;
            margin-left: 8px;
        }
        .btn-sync:hover { border-color: #6366f1; color: #6366f1; background: rgba(99, 102, 241, 0.1); }
    </style>
</head>
<body>

    <nav class="navbar navbar-expand-lg fixed-top">
        <div class="container">
            <a class="btn-back" href="/dashboard">
                <i class="fas fa-chevron-left"></i> Voltar
            </a>
            <span class="navbar-brand text-white fw-bold mx-auto pe-5 fs-5">
                <i class="fas fa-landmark me-2 text-warning"></i> Área de Saque
            </span>
        </div>
    </nav>

    <div class="container" style="margin-top: 100px; padding-bottom: 50px;">
        
        <div class="row justify-content-center">
            <div class="col-lg-5 mb-4">
                <div class="glass-panel">
                    <div class="balance-card d-flex justify-content-between align-items-center">
                        <div>
                            <span class="d-block small text-white-50 text-uppercase ls-1">Saldo Disponível</span>
                            <span class="fs-2 fw-bold">R$ <%= parseFloat(user.balance).toFixed(2) %></span>
                        </div>
                        <i class="fas fa-wallet fs-1 text-white-50"></i>
                    </div>

                    <% if (error) { %> 
                        <div class="alert alert-danger border-0 bg-danger bg-opacity-10 text-danger d-flex align-items-center mb-4">
                            <i class="fas fa-exclamation-circle me-2"></i> <%= error %>
                        </div> 
                    <% } %>
                    <% if (success) { %> 
                        <div class="alert alert-success border-0 bg-success bg-opacity-10 text-success d-flex align-items-center mb-4">
                            <i class="fas fa-check-circle me-2"></i> <%= success %>
                        </div> 
                    <% } %>
                    
                    <div class="d-flex align-items-start gap-2 mb-4 p-3 rounded-3" style="background: rgba(251, 191, 36, 0.1); border: 1px dashed rgba(251, 191, 36, 0.3);">
                        <i class="fas fa-info-circle text-warning mt-1"></i>
                        <p class="mb-0 small text-warning opacity-75">
                            Saques via PIX são processados automaticamente. Em casos raros, pode levar até <strong>24 horas</strong>. Taxa: R$ <%= parseFloat(settings.fee_sac).toFixed(2) %>.
                        </p>
                    </div>

                    <form action="/withdraw" method="POST">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label">Tipo de Chave</label>
                                <select name="key_type" class="form-select">
                                    <option value="cpf" selected>CPF</option>
                                    <option value="email">E-mail</option>
                                    <option value="phone">Telefone (Celular)</option>
                                    <option value="random">Chave Aleatória</option>
                                </select>
                            </div>
                            
                            <div class="col-12">
                                <label class="form-label">Chave PIX</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-dark border-secondary text-secondary"><i class="fas fa-key"></i></span>
                                    <input type="text" name="pix_key" class="form-control" placeholder="Digite sua chave aqui" required>
                                </div>
                            </div>

                            <div class="col-12">
                                <label class="form-label">Valor do Saque</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-dark border-secondary text-secondary">R$</span>
                                    <input type="number" step="0.01" name="amount" class="form-control fw-bold" placeholder="0.00" required>
                                </div>
                            </div>

                            <div class="col-12 mt-4">
                                <button type="submit" class="btn-action">
                                    Confirmar Saque <i class="fas fa-arrow-right ms-2"></i>
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="glass-panel h-100">
                    <h5 class="fw-bold text-white mb-4"><i class="fas fa-history me-2 text-primary"></i>Histórico de Saques</h5>
                    
                    <div class="d-flex flex-column gap-1">
                        <% if (withdraws && withdraws.length > 0) { %>
                            <% withdraws.forEach(tx => { %>
                                <div class="history-item">
                                    <div class="d-flex align-items-center">
                                        <div class="icon-box">
                                            <i class="fas fa-arrow-up"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold text-white">Saque Pix</div>
                                            <div class="small text-secondary" style="font-size: 0.8rem;">
                                                <%= new Date(tx.date).toLocaleDateString('pt-BR', {timeZone: 'America/Sao_Paulo'}) %> • <%= tx.pix_key.substring(0, 12) %>...
                                            </div>
                                        </div>
                                    </div>
                                    <div class="text-end">
                                        <div class="fw-bold text-danger">- R$ <%= parseFloat(tx.val).toFixed(2) %></div>
                                        <div class="mt-1">
                                            <% if(tx.status === 'completed') { %>
                                                <span class="status-badge status-success">Pago</span>
                                            <% } else if(tx.status === 'pending') { %>
                                                <span class="status-badge status-pending">Processando</span>
                                                <button class="btn-sync" onclick="checkWithdrawStatus('<%= tx.id %>', this)" title="Atualizar Status">
                                                    <i class="fas fa-sync-alt" style="font-size: 0.7rem;"></i>
                                                </button>
                                            <% } else { %>
                                                <span class="status-badge status-failed">Falhou</span>
                                            <% } %>
                                        </div>
                                    </div>
                                </div>
                            <% }) %>
                        <% } else { %>
                            <div class="text-center py-5">
                                <i class="fas fa-piggy-bank fs-1 text-secondary opacity-25 mb-3"></i>
                                <p class="text-secondary">Você ainda não realizou saques.</p>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <input type="hidden" id="csrfToken" value="<%= csrfToken %>">
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        let autoCheckIntervals = {};
        
        async function verificarSaqueAuto(saqueId, btn) {
            if (!saqueId) return;
            
            const csrf = document.getElementById('csrfToken')?.value;
            if (!csrf) return;
            
            try {
                const response = await fetch('/api/v1/confirmar-saque', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ csrf: csrf, 'saque-id': saqueId })
                });
                const result = await response.json();
                
                if (result.error) {
                    clearInterval(autoCheckIntervals[saqueId]);
                    showErrorPopup(result.error);
                    if (btn) {
                        const historyItem = btn.closest('.history-item');
                        if (historyItem) {
                            const badge = historyItem.querySelector('.status-badge');
                            if (badge) {
                                badge.className = 'status-badge status-danger';
                                badge.innerText = 'Falhou';
                            }
                            btn.remove();
                        }
                    }
                    return;
                }
                
                if (result.dinheiro_sacado === true) {
                    clearInterval(autoCheckIntervals[saqueId]);
                    if (btn) {
                        const historyItem = btn.closest('.history-item');
                        if (historyItem) {
                            const badge = historyItem.querySelector('.status-badge');
                            if (badge) {
                                badge.className = 'status-badge status-success';
                                badge.innerText = 'Pago';
                            }
                            btn.remove();
                        }
                    }
                    showWithdrawSuccessPopup(result.valor || 0);
                }
            } catch (e) {
                console.error('Erro auto-check saque:', e);
            }
        }
        
        function showWithdrawSuccessPopup(valor) {
            const popup = document.createElement('div');
            popup.style.cssText = 'position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.8);display:flex;align-items:center;justify-content:center;z-index:9999;';
            popup.innerHTML = `
                <div style="background:linear-gradient(135deg,#8b5cf6,#6366f1);padding:40px;border-radius:20px;text-align:center;animation:popIn 0.3s ease;">
                    <i class="fas fa-check-circle" style="font-size:80px;color:white;margin-bottom:20px;"></i>
                    <h2 style="color:white;margin-bottom:10px;">Saque Aprovado!</h2>
                    <p style="color:rgba(255,255,255,0.9);font-size:24px;font-weight:bold;">R$ ${valor ? valor.toFixed(2) : '0.00'}</p>
                    <p style="color:rgba(255,255,255,0.7);margin-top:15px;">O valor foi enviado para sua chave PIX!</p>
                    <button onclick="this.parentElement.parentElement.remove()" style="margin-top:20px;padding:10px 30px;background:white;color:#6366f1;border:none;border-radius:10px;font-weight:bold;cursor:pointer;">Fechar</button>
                </div>
            `;
            document.body.appendChild(popup);
        }
        
        function showErrorPopup(mensagem) {
            const popup = document.createElement('div');
            popup.style.cssText = 'position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.8);display:flex;align-items:center;justify-content:center;z-index:9999;';
            popup.innerHTML = `
                <div style="background:linear-gradient(135deg,#ef4444,#dc2626);padding:40px;border-radius:20px;text-align:center;animation:popIn 0.3s ease;max-width:400px;">
                    <i class="fas fa-times-circle" style="font-size:80px;color:white;margin-bottom:20px;"></i>
                    <h2 style="color:white;margin-bottom:10px;">Erro no Saque</h2>
                    <p style="color:rgba(255,255,255,0.9);font-size:16px;">${mensagem}</p>
                    <button onclick="this.parentElement.parentElement.remove(); location.reload();" style="margin-top:20px;padding:10px 30px;background:white;color:#dc2626;border:none;border-radius:10px;font-weight:bold;cursor:pointer;">Fechar</button>
                </div>
            `;
            document.body.appendChild(popup);
        }
        
        async function checkWithdrawStatus(txId, btn) {
            const icon = btn.querySelector('i');
            const csrf = document.getElementById('csrfToken')?.value;
            
            icon.classList.add('fa-spin'); 
            btn.disabled = true;
            btn.style.opacity = '0.5';

            try {
                const response = await fetch('/api/v1/confirmar-saque', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ csrf: csrf, 'saque-id': txId })
                });
                const data = await response.json();

                if (data.dinheiro_sacado === true) {
                    clearInterval(autoCheckIntervals[txId]);
                    btn.closest('.history-item').querySelector('.status-badge').className = 'status-badge status-success';
                    btn.closest('.history-item').querySelector('.status-badge').innerText = 'Pago';
                    btn.remove();
                    showWithdrawSuccessPopup(data.valor || 0);
                } else if (data.error) {
                    clearInterval(autoCheckIntervals[txId]);
                    btn.closest('.history-item').querySelector('.status-badge').className = 'status-badge status-danger';
                    btn.closest('.history-item').querySelector('.status-badge').innerText = 'Falhou';
                    btn.remove();
                    showErrorPopup(data.error);
                } else {
                    const originalColor = btn.style.borderColor;
                    btn.style.borderColor = '#facc15';
                    setTimeout(() => { btn.style.borderColor = originalColor; }, 1000);
                }
            } catch (error) {
                console.error(error);
            } finally {
                icon.classList.remove('fa-spin');
                btn.disabled = false;
                btn.style.opacity = '1';
            }
        }
        
        document.addEventListener('DOMContentLoaded', function() {
            const syncButtons = document.querySelectorAll('.btn-sync');
            syncButtons.forEach(btn => {
                const txId = btn.getAttribute('onclick')?.match(/'([^']+)'/)?.[1];
                if (txId) {
                    autoCheckIntervals[txId] = setInterval(() => verificarSaqueAuto(txId, btn), 1500);
                    verificarSaqueAuto(txId, btn);
                }
            });
        });
    </script>
    
    <style>
        @keyframes popIn {
            from { transform: scale(0.5); opacity: 0; }
            to { transform: scale(1); opacity: 1; }
        }
    </style>

    <%- include('partials/footer') %>
</body>
</html>
